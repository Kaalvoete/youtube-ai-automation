# ============================================
# AI PROVIDER CONFIGURATION
# ============================================

# AI Provider: anthropic (default), openai, cohere
AI_PROVIDER=anthropic

# AI Model (leave empty for default per provider)
# Anthropic: claude-3-5-haiku-latest, claude-sonnet-4-20250514, etc.
# OpenAI: gpt-3.5-turbo, gpt-4, etc.
AI_MODEL=

# ============================================
# API KEYS & CREDENTIALS
# ============================================

# Anthropic API Key (default provider)
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (alternative provider)
# Get free $5 credits at: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Cohere API Key (alternative to OpenAI, free tier)
# Get at: https://dashboard.cohere.ai
COHERE_API_KEY=your_cohere_api_key_here

# ElevenLabs API Key (optional - for better AI voices)
# Get free 10K characters at: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ============================================
# YOUTUBE CONFIGURATION
# ============================================

# Your YouTube Channel ID
# Find at: https://studio.youtube.com (About tab)
YOUTUBE_CHANNEL_ID=UCcItHjCePEXykLke8QIhqZQ

# YouTube OAuth Credentials (set up in Google Cloud Console)
# Leave blank initially, set after running setup.py
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ============================================
# VIDEO SETTINGS
# ============================================

# Shorts video length (seconds)
VIDEO_LENGTH_SHORTS=60

# Long-form video length (seconds) - 300 = 5 mins
VIDEO_LENGTH_LONG=300

# Video quality
VIDEO_QUALITY=1080p

# Frames per second
FPS=30

# ============================================
# UPLOAD SCHEDULE
# ============================================

# Time to upload daily (24-hour format)
DAILY_UPLOAD_TIME=09:00

# Number of videos to generate per day
VIDEOS_PER_DAY=2

# ============================================
# CONTENT SETTINGS
# ============================================

# Niche/Topic
NICHE=AI & Automation Hacks

# Language
TARGET_LANGUAGE=en

# Video visibility: public, unlisted, private
VIDEO_VISIBILITY=public
